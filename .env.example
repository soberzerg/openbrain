# Telegram Bot
BOT_TOKEN=123456:ABC-DEF...
ALLOWED_USER_IDS=123456789,987654321

# Claude Code CLI
CLAUDE_CLI_PATH=claude
CLAUDE_WORKING_DIR=/path/to/your/working/directory
CLAUDE_TIMEOUT_SECONDS=120
# Permission profile: full, safe, readonly
CLAUDE_PERMISSION_PROFILE=full

# Obsidian / second-brain
OBSIDIAN_VAULT_PATH=
OBSIDIAN_INBOX_SUBDIR=
GIT_AUTO_SYNC=true

# Session management
SESSION_TIMEOUT_MINUTES=30

# Rate limiting
RATE_LIMIT_PER_MINUTE=10

# Voice messages (OpenAI Whisper API)
OPENAI_API_KEY=
WHISPER_MODEL=whisper-1
WHISPER_BASE_URL=https://api.openai.com/v1

# Content routing
ROUTING_CONFIG_PATH=config/routing.yaml

# Proactive notifications
NOTIFICATIONS_ENABLED=false
MORNING_DIGEST_HOUR=9
WEEKLY_SUMMARY_DAY=0
WEEKLY_SUMMARY_HOUR=10
TZ=UTC
